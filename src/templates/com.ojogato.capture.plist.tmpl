<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Camera -> loopback RTSP publisher. capture-stream.sh execs the ffmpeg inside
     OjoGato.app so macOS TCC attributes camera access to the Ojo de Gato bundle. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ojogato.capture</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@OJOGATO_HOME@/bin/capture-stream.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>@OJOGATO_HOME@/logs/capture-launchd.log</string>
  <key>StandardErrorPath</key><string>@OJOGATO_HOME@/logs/capture-launchd.err</string>
</dict>
</plist>
