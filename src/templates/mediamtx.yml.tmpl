# Ojo Gato mediamtx config — rendered by install.sh to ~/.ojogato/mediamtx.yml.
# RTSP stays loopback-only (the camera feed never leaves the machine unencrypted);
# HLS (:8888) and WebRTC (:8889) bind all interfaces so Tailscale peers can watch.
# @OJOGATO_WEBRTC_HOSTS@ is replaced by the installer with the detected Tailscale
# IP / MagicDNS name (comma-separated), or left as an empty list.
logLevel: info
logDestinations: [file]
logFile: @OJOGATO_HOME@/logs/mediamtx.log
rtsp: yes
rtspAddress: 127.0.0.1:8554
rtmp: no
srt: no
hls: yes
hlsAddress: :8888
webrtc: yes
webrtcAddress: :8889
webrtcAdditionalHosts: [@OJOGATO_WEBRTC_HOSTS@]
paths:
  cam:
