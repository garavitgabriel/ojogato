# Ojo de Gato config — copied by setup to ~/.ojogato/config.env (chmod 600, never committed).
# KEY=VALUE, shell-sourceable: every runtime script sources this file at startup.
# After changing capture/stream values, restart the stack: ojogato off && ojogato on

# --- Camera & stream ---------------------------------------------------------
OJOGATO_DEVICE="0"                  # avfoundation device index or exact name
                                    # (list: ~/.ojogato/bin/ffmpeg -f avfoundation -list_devices true -i "")
OJOGATO_RES="1280x720"              # capture resolution
OJOGATO_STREAM_FPS="12"             # published stream fps (camera captures at 30, filter downsamples)
OJOGATO_BITRATE="500k"              # h264_videotoolbox target bitrate (~0.22 GB/hour at 500k)

# --- Recording retention -----------------------------------------------------
OJOGATO_RETENTION_HOURS="48"        # recordings (and motion frames) older than this are deleted
OJOGATO_CAP_GB="9"                  # recordings folder hard cap, oldest-first eviction

# --- Motion detection (mpdecimate tuning — see docs/motion-tuning.md) --------
OJOGATO_MOTION_FPS="1"              # frames/sec analyzed for motion
OJOGATO_MOTION_HI="48"              # mpdecimate hi threshold (x64); lower = more sensitive
OJOGATO_MOTION_LO="24"              # mpdecimate lo threshold (x64)
OJOGATO_MOTION_FRAC="0.6"           # fraction of blocks that must change
# Prefilter applied before mpdecimate. deflicker cancels the webcam's auto-exposure
# steps (global brightness shifts that fake motion in an empty room). "null" disables.
OJOGATO_MOTION_PREFILTER="deflicker=size=5:mode=am"
# Burst clustering (clip.sh + motion-stats.sh): frames <= GAP seconds apart are one
# event; an event needs >= MIN frames to count as real movement. Isolated frames are
# treated as residual false positives (exposure steps) and never anchor clips or stats.
OJOGATO_BURST_GAP="4"
OJOGATO_BURST_MIN="2"
# Seconds the detector's frame timestamps trail real wall-clock time. Motion frames are
# named when the JPEG is written, and deflicker=size=N buffers N frames before emitting
# one — at MOTION_FPS=1 that alone is ~5s, plus RTSP/decode buffering. clip.sh subtracts
# this before cutting; too small and the clip starts after the subject has left.
# Re-measure after changing MOTION_FPS or the prefilter — see docs/motion-tuning.md.
OJOGATO_DETECT_LAG="6"
# Mean luma (0-255) below which the scene counts as unlit. There is no IR, so below this
# a clip shows nothing and motion counts inflate on sensor grain; reports say so rather
# than implying we saw something. ~8 lights-out vs ~43 lit on the reference camera.
OJOGATO_DARK_YAVG="16"

# --- Telegram (plain Bot API — works standalone, no agent needed) ------------
OJOGATO_TELEGRAM_TOKEN=""           # bot token from @BotFather
OJOGATO_TELEGRAM_CHAT=""            # your chat id (setup wizard finds it via getUpdates)

# --- Live view ----------------------------------------------------------------
OJOGATO_LIVE_URL=""                 # e.g. http://<tailscale-name>:8889/cam ; setup auto-fills if tailscale found

# --- Watchdog (heartbeat.sh) ---------------------------------------------------
OJOGATO_NO_MOTION_HOURS="6"         # no-motion alarm threshold (daytime)
OJOGATO_DAY_START="8"               # local hours for the no-motion alarm window
OJOGATO_DAY_END="23"

# --- Messaging ----------------------------------------------------------------
OJOGATO_SUBJECT="the cats"          # what we're watching; used in message text

# Optional: names of the pets/subjects, comma-separated (e.g. "Milo, Lila, Lulo").
# The agent uses these to talk about them naturally. Motion detection cannot tell
# individuals apart, so the agent refers to them collectively — never "Milo moved".
OJOGATO_PET_NAMES=""
