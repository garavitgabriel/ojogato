# Ojo de Gato config — copied by setup to ~/.ojogato/config.env (chmod 600, never committed).
# KEY=VALUE, shell-sourceable: every runtime script sources this file at startup.
# After changing capture/stream values, restart the stack: ojogato off && ojogato on

# --- Camera & stream ---------------------------------------------------------
OJOGATO_DEVICE_NAME=""             # substring of the camera name, e.g. "FaceTime HD". Empty = first real camera.
# NOTE: the input is resolved to an avfoundation index BY NAME at every start, and
# screen-capture pseudo-devices are excluded and can never be chosen. Indices are
# positional over whatever exists at that moment: on 2026-08-15 the built-in camera
# dropped off the bus and index 0 silently became "Capture screen 0". A missing camera is
# now a loud stop, never a fallback. OJOGATO_DEVICE is kept only for legacy configs.
OJOGATO_DEVICE="0"                  # avfoundation device index or exact name
                                    # (list: ~/.ojogato/bin/ffmpeg -f avfoundation -list_devices true -i "")
OJOGATO_RES="1280x720"              # capture resolution
OJOGATO_STREAM_FPS="12"             # published stream fps (camera captures at 30, filter downsamples)
OJOGATO_BITRATE="500k"              # h264_videotoolbox target bitrate (~0.22 GB/hour at 500k)

# --- Recording retention -----------------------------------------------------
OJOGATO_RETENTION_HOURS="48"        # recordings (and motion frames) older than this are deleted
OJOGATO_CAP_GB="9"                  # recordings folder hard cap, oldest-first eviction

# --- Motion detection (mpdecimate tuning — see docs/motion-tuning.md) --------
# These four are the LIT-ROOM ("day") profile — the night profile is further down.
OJOGATO_MOTION_FPS="1"              # frames/sec analyzed for motion
OJOGATO_MOTION_HI="48"              # mpdecimate hi threshold (x64); lower = more sensitive
OJOGATO_MOTION_LO="24"              # mpdecimate lo threshold (x64)
OJOGATO_MOTION_FRAC="0.6"           # fraction of blocks that must change
# Prefilter applied before mpdecimate. deflicker cancels the webcam's auto-exposure
# steps (global brightness shifts that fake motion in an empty room). "null" disables.
OJOGATO_MOTION_PREFILTER="deflicker=size=5:mode=am"
# Burst clustering (clip.sh + motion-stats.sh): frames <= GAP seconds apart are one
# event; an event needs >= MIN frames to count as real movement. Isolated frames are
# treated as residual false positives (exposure steps) and never anchor clips or stats.
OJOGATO_BURST_GAP="4"
OJOGATO_BURST_MIN="2"
# Seconds the detector's frame timestamps trail real wall-clock time. Motion frames are
# named when the JPEG is written, and deflicker=size=N buffers N frames before emitting
# one — at MOTION_FPS=1 that alone is ~5s, plus RTSP/decode buffering. clip.sh subtracts
# this before cutting; too small and the clip starts after the subject has left.
# Re-measure after changing MOTION_FPS or the prefilter — see docs/motion-tuning.md.
OJOGATO_DETECT_LAG="6"

# --- Day / night profiles (motion-profile.sh) ---------------------------------
# The detector runs one of two threshold sets, chosen by how much light the sensor
# actually has — not by the clock. A lamp left on at 23:00 is the "day" regime; a
# shuttered room at 15:00 is the "night" one, and a clock gets both wrong.
#   auto      measure mean luma and switch (default)
#   schedule  use OJOGATO_DAY_START..OJOGATO_DAY_END instead
#   day|night pin one profile
#   off       ignore profiles entirely; the values above always apply
OJOGATO_PROFILE_MODE="auto"
# Hysteresis pair, mean luma 0-255. Below DARK -> night; above LIT -> day; in between the
# current profile holds, so dusk doesn't flap the detector between the two every 5 minutes.
# Reference camera: ~2 lights-out at 02:00, ~11 dim, ~43 lit, ~90 full daylight.
# DARK_YAVG doubles as the "nothing is visible" line used by report.sh captions: there is
# no IR, so below it a clip shows nothing and counts inflate on sensor grain.
OJOGATO_DARK_YAVG="16"
OJOGATO_LIT_YAVG="24"
# Night thresholds. Stricter than day because at max sensor gain the frame is largely
# grain and mpdecimate scores grain as change. Measured on the reference camera: over a
# 10-min dark segment 48/24 kept 6 frames, 72/36 kept 3, 96/48 kept 3 — the gain is real
# but small, and the honest limit at night is that the room is not visible at all.
OJOGATO_NIGHT_MOTION_HI="72"
OJOGATO_NIGHT_MOTION_LO="36"
OJOGATO_NIGHT_MOTION_FRAC="0.6"
OJOGATO_NIGHT_MOTION_PREFILTER="deflicker=size=5:mode=am"

# --- Detector liveness (motion-run.sh + heartbeat.sh) -------------------------
# The detector writes frames/detector-alive.jpg on this interval no matter what the room
# is doing. It exists because a wedged pipeline and an empty room both produce zero motion
# frames — on 2026-08-10 ffmpeg decoded for 12h45m while its filter graph emitted nothing,
# and nothing noticed. heartbeat.sh restarts the detector when this frame goes stale.
OJOGATO_DETECTOR_ALIVE_SEC="30"
OJOGATO_DETECTOR_STALL_SEC="180"    # staleness that counts as wedged

# --- Telegram (plain Bot API — works standalone, no agent needed) ------------
OJOGATO_TELEGRAM_TOKEN=""           # bot token from @BotFather
OJOGATO_TELEGRAM_CHAT=""            # your chat id (setup wizard finds it via getUpdates)

# --- Live view ----------------------------------------------------------------
OJOGATO_LIVE_URL=""                 # e.g. http://<tailscale-name>:8889/cam ; setup auto-fills if tailscale found

# --- Supervisor alarms (heartbeat.sh) -----------------------------------------
OJOGATO_NO_MOTION_HOURS="6"         # no-motion alarm threshold (daytime)
OJOGATO_DAY_START="8"               # local hours for the no-motion alarm window
OJOGATO_DAY_END="23"

# --- Messaging ----------------------------------------------------------------
OJOGATO_SUBJECT="the cats"          # what we're watching; used in message text

# Optional: names of the pets/subjects, comma-separated (e.g. "Milo, Lila, Lulo").
# The agent uses these to talk about them naturally. Motion detection cannot tell
# individuals apart, so the agent refers to them collectively — never "Milo moved".
OJOGATO_PET_NAMES=""

# --- Subject verification (ojogato-vision, on-device Apple Vision) -------------
# The layer that decides whether a motion frame contains a CAT/DOG/PERSON or just a
# camera that re-metered its exposure. Without it the detector reports pixel change as
# activity: measured 2026-08-15, 1,655 "motion" frames in a day of which only 24 runs
# held an actual subject, and the "last movement" clip sent to the phone was anchored on
# auto-exposure flicker over an empty room.
#
# Everything is on-device (Apple's Vision framework — no model download, no network, no
# API key). Set ENABLED=0 to fall back to the old raw-frame behaviour; reports then say
# "unverified" rather than pretending.
OJOGATO_VISION_ENABLED="1"
OJOGATO_VISION_MIN_CONFIDENCE="0.30"  # floor for a recognition to count
OJOGATO_VISION_TILES="3x2"            # 3x2 | 2x2 | 0 (off). Overlapping crops; see below.
OJOGATO_VISION_INTERVAL="5"           # seconds between passes over new frames
OJOGATO_VISION_BATCH="200"            # max frames classified per pass (backlog is paced)
OJOGATO_VISION_STALL_SEC="300"        # verifier silence that counts as stalled

# Tiling is not an optimisation. Vision downsamples its input, so a cat down the corridor
# produces NO observation at all rather than a low-confidence one — which is why lowering
# MIN_CONFIDENCE does nothing for distant subjects and only tiling recovers them. Measured
# on the reference camera: full-frame 199 animal frames/day, 3x2 tiled 349, same floor,
# no new false positives. Set to 0 only on a machine too slow to afford it.

# An EVENT is a run of candidate frames no more than this many seconds apart. It counts as
# real if a subject was recognised in at least ONE of its frames — event-level, because
# the recogniser legitimately misses individual frames (a ragdoll with its back turned,
# pale fur on pale tile, a person cropped to a forearm) but a subject that is really there
# stays for seconds and lands in many frames. Exposure flicker produces runs where it is
# recognised in none.
OJOGATO_EVENT_GAP="30"

# How far back clip.sh will look for a verified event to cut "last movement" from. Beyond
# this it reports that nothing has been seen rather than shipping stale footage.
OJOGATO_CLIP_LOOKBACK_HOURS="24"

# --- Scheduled digests (com.ojogato.digest) -------------------------------------
# Who sends the 09:00 digest and the 21:00 digest-with-recap. Exactly one sender:
#   standalone  ojogato's own launchd job (plain Telegram, no agent needed)
#   agent       your agent's scheduler (OpenClaw's ojogato-digest-* crons); the job idles
#   off         no scheduled digests
# install.sh fills this in: agent when ~/.openclaw exists, standalone otherwise. The job also
# stands down if it finds OpenClaw's digest crons, so the two can never double-send.
OJOGATO_DIGEST_MODE=""

# --- MCP server (com.ojogato.mcp) — see docs/mcp-server.md ----------------------
# Lets an MCP-capable agent (Claude Code, Hermes, Codex) read status, events and frames.
# Read-only: no tool can switch the camera off or change config. Off by default.
OJOGATO_MCP_ENABLED="0"             # 1 = load com.ojogato.mcp (ojogato on / install)
OJOGATO_MCP_BIND="127.0.0.1"        # 127.0.0.1 | tailscale | an explicit IP. NEVER 0.0.0.0 (refused)
OJOGATO_MCP_PORT="8790"
OJOGATO_MCP_TOKEN=""                # bearer token; install/setup generate one (openssl rand -hex 32)
OJOGATO_MCP_PUBLIC_URL=""           # base for media links, e.g. http://<tailnet-name>:8790 ; empty = bind+port
OJOGATO_MCP_MEDIA_TTL="3600"        # seconds a signed media link stays valid
